# n9router Configuration
# Copy this file to .env and adjust values as needed.

# ─── n9router ────────────────────────────────────────────────────────────────
# n9router version (pinned at build time)
N9ROUTER_VERSION=0.4.30

# Host port to expose n9router on
N9ROUTER_PORT=20128

# Set to "true" to require API key authentication
N9ROUTER_REQUIRE_API_KEY=true

# API key (required if N9ROUTER_REQUIRE_API_KEY=true)
N9ROUTER_API_KEY=

# Debug mode
DEBUG=false

# ─── Cloudflare Tunnel (optional, use --profile tunnel) ──────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=

# ─── Pilot Server (optional, use --profile full-stack) ────────────────────────
# PILOT_PORT=3000

# ─── Access URLs ──────────────────────────────────────────────────────────────
# After starting, n9router is available at:
#   http://localhost:20128          (local)
#   http://<YOUR_TAILSCALE_IP>:20128       (Tailscale)
#   http://<YOUR_TAILSCALE_IP>:20128/v1    (OpenCode API)
