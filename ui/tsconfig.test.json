{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["src/*"],
      "@MerverliPy/pilot-shared": ["../shared/src/types.ts"],
      "@pilot-shared/types": ["../shared/src/types.ts"],
      "@opencode-ai/plugin": ["__mocks__/@opencode-ai/plugin.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "__mocks__/**/*.ts",
    "types/**/*.d.ts"
  ]
}
