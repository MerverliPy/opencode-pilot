{
  "name": "@MerverliPy/pilot",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "server",
    "ui",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w ui",
    "dev:server": "npm run dev -w server",
    "dev:ui": "npm run dev -w ui",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w ui",
    "build:server": "npm run build -w server",
    "build:ui": "npm run build -w ui",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w ui",
    "lint": "npm run lint -w ui",
    "test": "npm run test -w ui",
    "test:coverage": "npm run test:coverage -w ui",
    "test:watch": "npm run test:watch -w ui",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3"
  }
}
