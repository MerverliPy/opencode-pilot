# Pilot Server Configuration
# Copy this file to .env and adjust values as needed.
# All variables are optional — defaults are shown below.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000                              # Server listen port (default: 3000)

# ─── OpenCode proxy ────────────────────────────────────────────────────────────
OPENCODE_URL=                          # Upstream OpenCode server URL
# OPENCODE_USERNAME=                   # Basic auth username (optional)
# OPENCODE_PASSWORD=                   # Basic auth password (optional)

# ─── n9router (AI model router) ──────────────────────────────────────────────
# URL for the n9router service (used as OPENCODE_URL upstream)
# When running n9router in Docker: http://localhost:20128 or http://100.81.83.98:20128
# N9ROUTER_URL=http://localhost:20128

# n9router API key (required if n9router auth is enabled)
# N9ROUTER_API_KEY=

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://100.81.83.98:5173,http://100.81.83.98:3000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100                     # Max requests per window (default: 100)

# ─── Body Size Limit ───────────────────────────────────────────────────────────
BODY_LIMIT_SIZE=10                     # Max body size in MB (default: 10)
