{
  "$schema": "https://opencode.ai/config.json",
  "model": "n9router/ds/deepseek-chat",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/pilot-core.md"
  ],
  "plugin": [
    "./.opencode/plugins/n9router-director.ts",
    "./.opencode/plugins/tool-guardrails.ts",
    "./.opencode/plugins/rtk-compressor.ts"
  ],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless"
      ],
      "enabled": false
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git ls-files*": "allow",
      "npm run build*": "allow",
      "npm run typecheck*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run test:e2e*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      ".git/**"
    ]
  },
  "share": "manual"
}
