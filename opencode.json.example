{
  "$schema": "https://opencode.ai/config.json",
  "model": "n9router/ds/deepseek-v4-flash",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/pilot-core.md"
  ],
  "plugin": [],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": false,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless"
      ],
      "enabled": false
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "*.env.example": "allow"
    },
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": {
      "*": "ask",
      "workflow-routing": "allow",
      "tdd-verification": "allow",
      "typescript-react-hono": "allow",
      "security-review": "ask",
      "server-boundary-security": "ask",
      "react-zustand-performance": "ask",
      "sqlite-memory-safety": "ask",
      "terminal-sse-streaming": "ask",
      "plugin-safety": "ask",
      "benchtest-analysis": "ask",
      "codemap-maintenance": "ask",
      "pilot-architecture": "ask",
      "pilot-performance": "ask",
      "pilot-self-run": "ask"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git push --force*": "deny",
      "curl *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git ls-files*": "allow",
      "npm run build*": "allow",
      "npm run typecheck*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run test:e2e*": "allow"
    },
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      ".git/**"
    ]
  },
  "share": "manual",
  "provider": {
    "n9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "N9Router",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "ds/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "ds/deepseek-chat": {
          "name": "DeepSeek Chat"
        },
        "ds/deepseek-reasoner": {
          "name": "DeepSeek Reasoner"
        },
        "build-fixer": {
          "name": "Build Fixer \u2192 ds/deepseek-v4-flash"
        },
        "scout": {
          "name": "Scout \u2192 ds/deepseek-v4-flash"
        },
        "docs-updater": {
          "name": "Docs \u2192 ds/deepseek-v4-flash"
        },
        "e2e-runner": {
          "name": "E2E \u2192 ds/deepseek-v4-flash"
        }
      }
    }
  },
  "small_model": "n9router/scout"
}
