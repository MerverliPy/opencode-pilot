# Pilot Server Configuration
# Copy this file to .env and adjust values as needed.
# All variables are optional — defaults are shown below.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3201                              # Server listen port (default: 3201)

# ─── OpenCode proxy ────────────────────────────────────────────────────────────
OPENCODE_URL=http://100.81.83.98:4096  # Upstream OpenCode server URL
# OPENCODE_USERNAME=                   # Basic auth username (optional)
# OPENCODE_PASSWORD=                   # Basic auth password (optional)

# ─── n9router (AI model router) ──────────────────────────────────────────────
# n9router runs on port 20128 (Docker). Used by Pilot UI for model browsing.
# This is NOT the OpenCode server — n9router provides AI model routing.
# N9ROUTER_URL=http://localhost:20128

# n9router API key (required if n9router auth is enabled)
# N9ROUTER_API_KEY=

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3201,http://100.81.83.98:5173,http://100.81.83.98:3201

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100                     # Max requests per window (default: 100)

# ─── Body Size Limit ───────────────────────────────────────────────────────────
BODY_LIMIT_SIZE=10                     # Max body size in MB (default: 10)

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Bearer token that protects all sensitive server routes when set.
# Routes protected: /terminal/*, /git/*, /tunnel/*, /push/*, /memory/*,
#                   /api/*, /event, /session*, /file*, /find*, /config/*,
#                   /agent*, /command*, /global/*
# When unset, auth is disabled and all routes are open (backward compatible).
# PILOT_AUTH_TOKEN=
