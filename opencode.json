{
  "$schema": "https://opencode.ai/config.json",
  "model": "n9router/orchestrator",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/pilot-core.md"
  ],
  "plugin": [
    "./.opencode/plugins/n9router-director.ts",
    "./.opencode/plugins/tool-guardrails.ts",
    "./.opencode/plugins/rtk-compressor.ts"
  ],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless"
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git ls-files*": "allow",
      "npm run build*": "allow",
      "npm run typecheck*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run test:e2e*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      ".git/**"
    ]
  },
  "share": "manual",
  "provider": {
    "n9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "N9Router",
      "options": {
        "baseURL": "http://100.81.83.98:20128/v1"
      },
      "models": {
        "ds/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "ds/deepseek-chat": {
          "name": "DeepSeek Chat"
        },
        "ds/deepseek-reasoner": {
          "name": "DeepSeek Reasoner"
        },
        "opencode/deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash (FREE via Zen) [DEAD]"
        },
        "oc/deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash (FREE via OpenCode Free)"
        },
        "gh/claude-sonnet-4": {
          "name": "Claude Sonnet 4 (via GitHub)"
        },
        "orchestrator": {
          "name": "Orchestrator → cx/gpt-5.5"
        },
        "implementer": {
          "name": "Implementer → cx/gpt-5.3-codex"
        },
        "build-fixer": {
          "name": "Build Fixer → ds/deepseek-v4-flash"
        },
        "scout": {
          "name": "Scout → ds/deepseek-v4-flash"
        },
        "code-reviewer": {
          "name": "Code Reviewer → gh/claude-sonnet-4.6"
        },
        "docs-updater": {
          "name": "Docs Updater → oc/qwen3.6-plus-free"
        },
        "security-auditor": {
          "name": "Security Auditor → gh/claude-sonnet-4.6"
        },
        "e2e-runner": {
          "name": "E2E Runner → oc/deepseek-v4-flash-free"
        }
      }
    }
  },
  "small_model": "n9router/scout"
}
